---
const stack = [
  { name: 'Astro 6.x', detail: 'SSG + adapter Cloudflare' },
  { name: 'Workers', detail: 'Edge serverless mondial' },
  { name: 'Tailwind v4', detail: 'CSS-first, plugin Vite' },
  { name: 'workerd natif', detail: 'Dev & preview = production' },
];
---

<section class="mx-auto max-w-3xl px-6 py-24" data-hero>
  <h1 data-hero-title class="mb-4">Isometria</h1>

  <p data-hero-text class="text-lead text-text-soft mb-12">
    Boilerplate Astro 6 + Tailwind v4, prêt à déployer sur Cloudflare Workers.
  </p>

  <ul data-hero-stack class="mb-12 grid list-none gap-4 p-0 sm:grid-cols-2">
    {
      stack.map((item) => (
        <li
          data-hero-card
          class="rounded-md border border-border bg-surface p-5 transition-colors hover:border-border-strong"
        >
          <strong class="block text-text">{item.name}</strong>
          <span class="text-sm text-text-soft">{item.detail}</span>
        </li>
      ))
    }
  </ul>

  <p data-hero-footer class="text-sm text-text-soft">
    <code>npm run dev</code>&nbsp;— lance workerd avec HMR
  </p>
</section>

<script>
  import { gsap } from '@/lib/gsap';

  gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
    gsap
      .timeline({ defaults: { ease: 'power3.out' } })
      .from('[data-hero-title]', { y: 32, opacity: 0, duration: 0.7 })
      .from(
        '[data-hero-text]',
        { y: 20, opacity: 0, duration: 0.6 },
        '-=0.4',
      )
      .from(
        '[data-hero-card]',
        { y: 24, opacity: 0, duration: 0.5, stagger: 0.08 },
        '-=0.35',
      )
      .from(
        '[data-hero-footer]',
        { y: 12, opacity: 0, duration: 0.4 },
        '-=0.2',
      );
  });
</script>
